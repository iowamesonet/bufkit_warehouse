// convert # symbol for some sites
$sym = "#";
$site_l = $site;
preg_match_all(".$sym.", $site, $id);
$check1 = @$id[0][0];
if ($check1 == $sym) {
    $exam = str_split($site);
    if ($exam[0] == $sym) {
        $exam[0] = "%23";
    }
    if ($exam[1] == $sym) {
        $exam[1] = "%23";
    }
    if ($exam[2] == $sym) {
        $exam[2] = "%23";
    }
    $site_l = "" . $exam[0] . "" . $exam[1] . "" . $exam[2] . "";
}

// check if site is in master list.  If not, terminate script and tell user
$found = 0;
for ($z = 0; $z <= 1; $z++) {
    if ($z == 0) {
        $master_list = "images/nam_bufrstations.txt";
    } elseif ($z == 1) {
        $master_list = "images/gfs3_bufrstations.txt";
    }
    $data = file($master_list);
    $sites = array();
    foreach ($data as $line) {
        $d = explode(" ", trim(preg_replace("/ +/", " ", $line)));
        $sites[] = strtolower($d[3]);
        if ($site == strtolower($d[3])) {
            $found = 1;
            if ($z == 0) {
                $lat = $d[1];
                $lon = $d[2];
            } elseif ($z == 1) {
                if (strpbrk($d[1], "N")) {
                    $lat = trim($d[1], "N");
                } else {
                    $lat = trim($d[1], "S") * -1;
                }
                if (strpbrk($d[2], "E")) {
                    $lon = trim($d[2], "E");
                } else {
                    $lon = trim($d[2], "W") * -1;
                }
            }
            break;
        }
    }
    if ($found == 1) {
        break;
    }
}

if (!(in_array($site, $sites))) {
    die("Site " . $site . " is not available.  Try again.");
}

