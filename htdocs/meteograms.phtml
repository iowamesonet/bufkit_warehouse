    $line_count = 11237;
    $line_count2 = 11232;
    $line_count3 = 11235;
    $line_count4 = 11230;
    $line_count5 = 11230;
    $j = 0;
    $i = -1;
    $k = -1;
    $l = -1;
    $m = -1;
    $v = -1;
    $link = METFS1 . "bufkit/nam/nam_" . $site . ".buf";

    $data = file($link) or die('Could not read file!');
    foreach ($data as $line) {

        $j++;

        if ($j == $line_count5 && $j <= 11734) {
            $v++;
            $line_count5 = $line_count5 + 6;
            $found_t = explode(" ", $line);
            $s = str_split($found_t[1]);
            $year = "20" . $s[0] . "" . $s[1] . "";
            $mon = "" . $s[2] . "" . $s[3] . "";
            $day = "" . $s[4] . "" . $s[5] . "";
            $hr = "" . $s[7] . "" . $s[8] . "";
            if ($j == 11230) {
                $hr_nam_init = $hr;
            }
            if ($year >= 2008) {
                $t[$v] = strtotime("" . $year . "-" . $mon . "-" . $day . " " . $hr . ":00:00Z");
            }
        }

        if ($j == $line_count4 && $j <= 11734) {

            $m++;
            $line_count4 = $line_count4 + 6;
            $found_txt = explode(" ", $line);
            $txt = str_split($found_txt[1]);
            $mon = "" . $txt[2] . "" . $txt[3] . "";
            $day = "" . $txt[4] . "" . $txt[5] . "";
            $time = "" . $txt[7] . "" . $txt[8] . "";
            $date[$m] = "" . $mon . "/" . $day . " @ " . $time . "z";
        }
        if ($j == $line_count) {

            $i++;
            $line_count = $line_count + 6;
            $found_it = explode(" ", trim($line));

            //precip calculations

            $mm = $found_it[0];
            $in = 0.03937008;
            $mm_to_in = round(($mm * $in), 2);
            $precip[$i] = "" . $mm_to_in . " in.";
            $acum[$i] = $mm_to_in;
            $add[$i] = array_sum($acum);
            $sum[$i] = "" . $add[$i] . " in.";
        }

        if ($j == $line_count3) {

            $l++;
            $line_count3 = $line_count3 + 6;
            $found_dpt = trim($line);
            $dew_f = round(((($found_dpt) * (9 / 5)) + 32), 0);
            if ($dew_f > -200) {
                $dew[$l] = "" . $dew_f . " F";
            } else {
                $dew[$l] = "-";
            }
            $dew2[$l] = $dew_f;
        }

        if ($j == $line_count2) {

            $k++;
            $line_count2 = $line_count2 + 6;
            $found_it2 = explode(" ", trim($line));

            //snow on ground

            $snra = $found_it2[0];
            $in = 0.03937008;
            $snra_to_in = round(($snra * $in), 3);
            $snow[$k] = "" . $snra_to_in . " in.";

            //snow melt

            $ro1m = $found_it2[3];
            $ro1m_to_in = round(($ro1m * $in), 3);
            $store1[$k] = "" . $ro1m_to_in . " in.";
            $acum_ro1m[$k] = $ro1m_to_in;
            $add_ro1m[$k] = array_sum($acum_ro1m);
            $sum_ro1m[$k] = "" . $add_ro1m[$k] . " in.";

            //storm runoff

            $bfgr = $found_it2[4];
            $bfgr_to_in = round(($bfgr * $in), 3);
            $store2[$k] = "" . $bfgr_to_in . " in.";
            $acum_bfgr[$k] = $bfgr_to_in;
            $add_bfgr[$k] = array_sum($acum_bfgr);
            $sum_bfgr[$k] = "" . $add_bfgr[$k] . " in.";

            //10m wind

            $winds_10m = sqrt(($found_it2[1] * $found_it2[1]) + ($found_it2[2] * $found_it2[2]));
            $ms_to_mph = round(($winds_10m * 2.23693629), 0);
            $wind_10m[$k] = "" . $ms_to_mph . " mph";
            $wind_10m2[$k] = $ms_to_mph;
            $nam_wind_x[] = $found_it2[1];
            $nam_wind_y[] = $found_it2[2];
            $wind_dir = @rad2deg(atan($found_it2[2] / $found_it2[1]));
            if ($found_it2[1] < 0 && $found_it2[2] > 0) {
                $wind_dir = $wind_dir + 180;
            }
            if ($found_it2[1] == 0 && $found_it2[2] > 0) {
