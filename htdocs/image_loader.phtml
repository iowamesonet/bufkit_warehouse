$lr = 64;
$ll = 359;
$ul1 = $ul;
$lr1 = $lr;

$mapdata = "";

$model_count = ($max - $min) / 3600;
for ($i = $min; $i <= $max; $i = $i + 3600) {
    foreach ($sources as $key => $src) {
        if ($src["check"] != 1) {
            continue;
        }
        $times = $src["times"];
        $width = isset($src["width"]) ? $src["width"] : 83;
        $bold = isset($src["bold"]) ? $src["bold"] : false;
        if (in_array($i, $times)) {
            $index = array_search($i, $times);
            $cols_vals = array();
            foreach ($src["cols"] as $col_arr) {
                $cols_vals[] = $col_arr[$index];
            }
            $cell_state[$key] = render_source_cells($src["label"], $src["dates"][$index], $cols_vals, $width, $bold);
        } elseif (!empty($times) && ($i < min($times) || $i > max($times))) {
            $cell_state[$key] = render_source_cells($src["label"], null, null, $width, $bold);
        }
    }

    $string_begin = "<area shape=rect coords=" . $ul . "," . $ur . "," . $lr . "," . $ll . " onMouseOver=\"writeText('";
    $string_end = "'); setMouse(this); \" />\n";

    $table_html = "<table border=0 cellspacing=0 cellpadding=0>";
    foreach ($row_titles as $r => $title) {
        $td_attr = ($r == 0) ? " width=62" : "";
        $table_html .= "<tr><td$td_attr>" . $title . "</td>";
        foreach ($sources as $key => $src) {
            $table_html .= $cell_state[$key][$r];
        }
        $table_html .= "</tr>";
    }
    $table_html .= "</table>";

    $mapdata .= "" . $string_begin . $table_html . $string_end . "";

    $ul1 = $lr + 1;
    $lr1 = $lr1 + (899 / ($model_count));

    $ul = round(($ul1), 0);
    $lr = round(($lr1), 0);
}

